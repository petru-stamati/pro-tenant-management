DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pro_tenant?schema=public"

PORT=3001
COOKIE_DOMAIN=localhost

JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Redis not yet provisioned on this machine (see packages/db/README.md) —
# caching/BullMQ modules will read this once it's available.
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 — optional locally. Leave unset to use local-disk storage
# for dev (apps/api/uploads/). Set all four to switch to R2 (see
# documents.module.ts) — needed in production, where local disk is wiped
# on every deploy/sleep.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
